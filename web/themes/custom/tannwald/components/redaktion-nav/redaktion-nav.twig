{#
/**
 * @file
 * SDC tannwald:redaktion-nav — Navigation des Redaktionsbereichs (1.3, Wireframe 03): linke Leiste auf md+
 * (44-px-Zeilen, Zähler tabellarisch rechts), Reiterzeile mit Unterstrich auf dem Phone; Queue-Stand darunter.
 * Props: items[] {label, url, count, active}, queue_label, queue_detail, attributes.
 */
#}
<nav{{ attributes.addClass('redaktion-nav') }} aria-label="{{ 'Editorial'|t }}">
  <ul class="redaktion-nav-list m-0 list-none p-0">
    {% for item in items %}
      <li class="contents">
        <a href="{{ item.url }}" class="redaktion-nav-item{{ item.active ? ' is-active' : '' }}"{% if item.active %} aria-current="page"{% endif %}>
          <span>{{ item.label }}</span>
          {% if item.count is not null %}<span class="redaktion-nav-count num">{{ item.count }}</span>{% endif %}
        </a>
      </li>
    {% endfor %}
  </ul>
  {% if queue_label %}
    <div class="redaktion-queue" data-queue-status>
      <span class="font-medium text-ink">{{ queue_label }}</span>
      {% if queue_detail %}<span>{{ queue_detail }}</span>{% endif %}
    </div>
  {% endif %}
</nav>
