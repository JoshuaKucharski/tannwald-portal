{#
/**
 * @file
 * SDC tannwald:search-live — Suchfeld mit Live-Resultaten (Alpine searchLive, src/app.js).
 */
#}
<div{{ attributes.addClass('relative flex-1 basis-80') }}
  x-data="searchLive({ liveUrl: '{{ live_url|e('js') }}', modusInput: '{{ modus_input|default('modus')|e('js') }}', maschineNid: {{ maschine_nid ? maschine_nid : 'null' }}, noticeBusy: '{{ 'Too many requests, please wait a moment.'|t|e('js') }}' })"
  @click.outside="close()">
  <div class="relative">
    <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <input id="{{ input_id }}" type="search" name="q" value="{{ query }}" maxlength="1000" autocomplete="off" autofocus
      placeholder="{{ placeholder }}" data-live-url="{{ live_url }}"
      class="h-11 w-full rounded-control border border-line bg-panel pl-10 pr-10"
      role="combobox" aria-autocomplete="list" aria-expanded="false" :aria-expanded="open ? 'true' : 'false'" aria-controls="{{ input_id }}-live"
      :aria-activedescendant="index >= 0 ? '{{ input_id }}-opt-' + index : null"
      x-model="query" @input.debounce.200ms="search()" @keydown="onKey($event)" @focus="reopen()">
    <button type="button" class="absolute right-0 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded text-muted hover:text-ink" aria-label="{{ 'Clear input'|t }}" x-show="query.length > 0" x-cloak @click="clear()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6 6 18"></path></svg>
    </button>
  </div>
  <div id="{{ input_id }}-live" x-show="open" x-cloak class="absolute left-0 right-0 top-full z-40 mt-1 overflow-hidden rounded-card border border-line bg-panel shadow-card" aria-label="{{ 'Live results while typing'|t }}">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line-soft px-4 py-2 text-sm text-muted">
      <span x-text="results.length ? '{{ 'While typing: top @n'|t({'@n': '4'})|e('js') }} · ' + (duration / 1000).toFixed(2) + ' s' : notice"></span>
      <span>{{ 'Enter for all hits'|t }}</span>
    </div>
    <ul role="listbox" class="m-0 list-none p-0">
      <template x-for="(r, i) in results" :key="r.url">
        <li role="option" :id="'{{ input_id }}-opt-' + i" :aria-selected="i === index ? 'true' : 'false'">
          <a :href="r.url" class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-sm text-ink no-underline hover:bg-surface" :class="i === index ? 'bg-surface' : ''" @mouseenter="index = i">
            <span class="min-w-0 flex-1 basis-64"><span class="font-medium" x-text="r.titel"></span> <span class="text-muted">›</span> <span x-text="r.heading_path"></span></span>
            <span class="flex items-center gap-1.5 text-sm text-muted"><span class="pill border-line uppercase" x-text="r.langcode"></span><span x-text="r.dokumenttyp"></span></span>
          </a>
        </li>
      </template>
    </ul>
  </div>
</div>
