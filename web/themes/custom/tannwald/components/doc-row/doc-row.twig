{#
/**
 * @file
 * SDC tannwald:doc-row — eine Dokumentzeile. Props siehe doc-row.component.yml.
 */
#}
<div{{ attributes.addClass('flex flex-wrap items-center gap-4 border-b border-line-soft px-6 py-4 last:border-b-0', is_current ? '' : 'bg-surface/70').setAttribute('data-revision', is_current ? 'current' : 'older') }}>
  <div class="flex min-w-0 flex-1 basis-80 flex-col gap-1">
    <span class="flex flex-wrap items-center gap-2.5">
      {% if url_dokument %}
        <a href="{{ url_dokument }}" class="font-semibold text-ink no-underline hover:text-accent">{{ title }}</a>
      {% else %}
        <span class="font-semibold">{{ title }}</span>
      {% endif %}
      {% for badge in badges|default([]) %}
        {{ include('tannwald:badge', badge, with_context = false) }}
      {% endfor %}
    </span>
    <span class="meta">
      {{ 'Version @version'|t({'@version': version}) }}
      {%- if freigegeben_am %} · {{ 'approved @date'|t({'@date': freigegeben_am}) }}{% endif %}
      {%- if not is_current %} · {{ 'Older version'|t }}{% endif %}
      {%- if audit_hint %} · {{ 'Access is logged'|t }}{% endif %}
      {%- if url_history %} · <a href="{{ url_history }}">{{ 'Change history'|t }}</a>{% endif %}
    </span>
  </div>
  {% if languages %}
    {{ include('tannwald:lang-pills', {languages: languages}, with_context = false) }}
  {% endif %}
  {% if is_new %}
    {{ include('tannwald:badge', {label: 'New version'|t, variant: 'ok', pill: true}, with_context = false) }}
  {% endif %}
  {% if url_download %}
    <a href="{{ url_download }}" class="btn btn-outline">{{ 'Download'|t({}, {'context': 'tannwald'}) }}</a>
  {% endif %}
</div>
