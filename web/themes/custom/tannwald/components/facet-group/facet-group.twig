{#
/**
 * @file
 * SDC tannwald:facet-group — Facettengruppe der Suche (1.3): 44-px-Zeilen, Zahl rechtsbündig (tabellarisch),
 * Legende gedämpft, „Zurücksetzen“ je Gruppe als Textlink; Checkboxen hängen per form= am Suchformular,
 * eine Änderung sendet ab. Ohne Items keine Ausgabe.
 */
#}
{% if items %}
  {% set field_name = param|default(name ~ '[]') %}
  {% set active_count = items|filter(i => i.active)|length %}
  <fieldset{{ attributes.addClass('m-0 flex flex-col border-0 p-0') }} data-facet="{{ name }}">
    <legend class="facet-legend">
      <span>{{ label }}</span>
      {% if active_count and reset_url %}
        <a href="{{ reset_url }}" class="font-normal">{{ 'Reset'|t({}, {'context': 'tannwald facet'}) }}</a>
      {% endif %}
    </legend>
    {% for item in items %}
      <label class="facet-row">
        <input type="checkbox" name="{{ field_name }}" value="{{ item.id }}" form="{{ form_id }}"{{ item.active ? ' checked' }} @change="$el.form.requestSubmit()">
        <span class="min-w-0 flex-1">{{ item.label }}</span>
        <span class="facet-count num">{{ item.count }}</span>
      </label>
    {% endfor %}
  </fieldset>
{% endif %}
