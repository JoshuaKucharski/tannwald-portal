{#
/**
 * @file
 * SDC tannwald:logo — Props: size, label, attributes.
 *
 * Geometrie aus dem 2048er-Original (Master-Messung, Nachtrag 3), auf viewBox 0 0 24 24 umgerechnet (Marke 22 hoch,
 * mittig): Stufe 1 Dreieck, Stufe 2 und 3 Trapeze, Lücke 1 (≈ 4.5 % der Höhe). Runde Ecken über den Strich
 * (stroke-linejoin round, 0.6), Farbe aus dem Text (currentColor: Blau-Token in der Kopfzeile, Weiss auf dem Markenpanel).
 */
#}
{% set px = size|default(28) %}
<svg{{ attributes.addClass('logo').setAttribute('width', px).setAttribute('height', px) }} viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="0.6" stroke-linejoin="round"{% if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true"{% endif %}><polygon points="12,1 18,8.75 6,8.75"/><polygon points="8,9.75 16,9.75 20.5,16 3.5,16"/><polygon points="6,17 18,17 22.75,23 1.25,23"/></svg>
