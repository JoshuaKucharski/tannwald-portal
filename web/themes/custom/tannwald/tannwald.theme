/**
 * Implements hook_form_FORM_ID_alter() for tannwald_ingest_review_form.
 *
 * D's Buttons gestylt (Freigeben primär, Entwurf speichern sekundär,
 * Zurückweisen Warnfarbe); Textarea trägt den Wortzähler (SDC review-actions).
 */
function tannwald_form_tannwald_ingest_review_form_alter(array &$form, FormStateInterface $form_state): void {
  // Nachtrag 5 (tw2-12): Sichtreihenfolge links nach rechts Zurückweisen ·
  // Entwurf speichern · Freigeben; Freigeben ganz rechts als Primär der Karte
  // (je Karte ein Formular, Leitplanken-Ausnahme „Listen aus Formular-Karten“),
  // die anderen sekundär. DOM-Reihenfolge = Sichtreihenfolge über #weight,
  // kein CSS order; das Sheet „Zurückweisen“ behält seinen Warn-Button.
  $buttons = [
    'zurueckweisen' => [0, ['btn', 'btn-secondary']],
    'entwurf_speichern' => [1, ['btn', 'btn-secondary']],
    'freigeben' => [2, ['btn', 'btn-primary']],
  ];
  foreach ($buttons as $transition => [$weight, $class]) {
    if (isset($form['actions'][$transition])) {
      $form['actions'][$transition]['#attributes']['class'] = $class;
      $form['actions'][$transition]['#weight'] = $weight;
    }
  }
  $form['actions']['#attributes']['class'][] = 'review-buttons';
  $form['body']['#attributes']['data-review-body'] = '';
  $form['body']['#attributes']['class'][] = 'review-textarea';
  // Die Redaktion sieht Text, nicht HTML: Absätze als Leerzeilen, Listen als
  // Zeilen mit „– “; reviewActions (src/app.js) baut vor dem Senden wieder
  // <p>/<ul> auf (D's Route filtert auf p ul ol li strong em).
  if (isset($form['body']['#default_value'])) {
    $form['body']['#default_value'] = _tannwald_review_html_to_text((string) $form['body']['#default_value']);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for content_moderation_entity_moderation_form.
 *
 * Vier-Augen-Hinweis auf Sicherheits-Bulletins der eigenen Erstellung (C's
 * Constraint NotOwnBulletinApproval meldet beim Freigeben); Buttons im
 * Theme-Stil.
 */
function tannwald_form_content_moderation_entity_moderation_form_alter(array &$form, FormStateInterface $form_state): void {
  if (isset($form['submit'])) {
    $form['submit']['#attributes']['class'] = ['btn', 'btn-primary'];
  }
  $entity = $form_state->get('entity');
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'bulletin') {
    return;
  }
  $isSafety = $entity->hasField('field_bulletin_art') && (string) $entity->get('field_bulletin_art')->value === 'sicherheit';
  $uid = (int) \Drupal::currentUser()->id();
  $own = (int) $entity->getOwnerId() === $uid;
  if (!$own && $entity->getRevisionUserId() !== NULL) {
    $own = (int) $entity->getRevisionUserId() === $uid;
  }
  if ($isSafety && $own && !$entity->isPublished()) {
    $form['tannwald_four_eyes'] = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['four-eyes-notice'], 'data-four-eyes' => ''],
      '#value' => t('Four-eyes principle: the person who created the bulletin must not approve it.'),
      '#weight' => -10,
    ];
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for node_dokument_form.
 *
 * „Dokument anlegen“ aus den unbeantworteten Fragen bringt ?title= mit.
 */
function tannwald_form_node_dokument_form_alter(array &$form, FormStateInterface $form_state): void {
  $title = \Drupal::request()->query->get('title');
  if (is_string($title) && $title !== '' && isset($form['title']['widget'][0]['value']) && empty($form['title']['widget'][0]['value']['#default_value'])) {
    $form['title']['widget'][0]['value']['#default_value'] = mb_substr($title, 0, 255);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for tannwald_access_export_rules.
 */
function tannwald_form_tannwald_access_export_rules_alter(array &$form, FormStateInterface $form_state): void {
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'] = ['btn', 'btn-primary'];
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for node_bulletin_edit_form.
 *
 * Derselbe Vier-Augen-Hinweis über dem Status-Widget des Bearbeiten-Formulars
 * (dort wählt die Redaktion „Freigegeben“; C's Constraint meldet den Verstoss).
 */
function tannwald_form_node_bulletin_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  $formObject = $form_state->getFormObject();
  if (!$formObject instanceof EntityFormInterface || !isset($form['moderation_state'])) {
    return;
  }
  $entity = $formObject->getEntity();
  if (!$entity instanceof NodeInterface) {
    return;
  }
  $isSafety = $entity->hasField('field_bulletin_art') && (string) $entity->get('field_bulletin_art')->value === 'sicherheit';
  $uid = (int) \Drupal::currentUser()->id();
  $own = (int) $entity->getOwnerId() === $uid || (int) $entity->getRevisionUserId() === $uid;
  if ($isSafety && $own && !$entity->isPublished()) {
    $form['moderation_state']['#prefix'] = '<p class="four-eyes-notice" data-four-eyes>'
      . t('Four-eyes principle: the person who created the bulletin must not approve it.') . '</p>';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_field.
 *
 * 6.1 (E): /bulletins zeigt der Redaktion und Compliance unveröffentlichte
 * Bulletins (Node-Grants); der Titel bekommt dort den Workflow-Zustand als
 * Badge, z. B. „Zur Prüfung“.
 */
function tannwald_preprocess_views_view_field(array &$variables): void {
  if ($variables['view']->id() !== 'portal_bulletins' || $variables['field']->field !== 'title') {
    return;
  }
  $node = $variables['row']->_entity ?? NULL;
  if (!$node instanceof NodeInterface || $node->isPublished() || !$node->hasField('moderation_state')) {
    return;
  }
  $state = (string) $node->get('moderation_state')->value;
  $workflow = \Drupal::service('content_moderation.moderation_information')->getWorkflowForEntity($node);
  if ($state === '' || $workflow === NULL || !$workflow->getTypePlugin()->hasState($state)) {
    return;
  }
  $variants = ['zur_pruefung' => 'warn', 'zurueckgewiesen' => 'danger'];
  $variables['output'] = [
    'title' => ['#markup' => Markup::create((string) $variables['output'])],
    'badge' => [
      '#type' => 'component',
      '#component' => 'tannwald:badge',
      '#props' => [
        'label' => $workflow->getTypePlugin()->getState($state)->label(),
        'variant' => $variants[$state] ?? 'neutral',
        'pill' => TRUE,
      ],
      '#attributes' => ['class' => ['ml-2']],
    ],
  ];
}

