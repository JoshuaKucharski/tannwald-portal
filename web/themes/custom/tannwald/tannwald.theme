<?php

/**
 * @file
 * Theme myTannwald: Preprocess-Hooks, Formular-Anpassungen (Aufgabe 5.1).
 *
 * Logik in includes/: layout.inc (Demo-Leiste, Kopfzeile, Brotkrumen),
 * machine.inc (Maschinenseite, Karten der Liste), document.inc (Dokument- und
 * Bulletinseite mit Kapitel-Ankern), search.inc (Suche 5.2), common.inc.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

require_once __DIR__ . '/includes/common.inc';
require_once __DIR__ . '/includes/layout.inc';
require_once __DIR__ . '/includes/machine.inc';
require_once __DIR__ . '/includes/document.inc';
require_once __DIR__ . '/includes/search.inc';

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function tannwald_preprocess_page(array &$variables): void {
  _tannwald_layout_prepare($variables);
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function tannwald_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  switch ($node->bundle()) {
    case 'maschine':
      _tannwald_machine_preprocess($variables, $node);
      break;

    case 'dokument':
      _tannwald_document_preprocess($variables, $node);
      break;

    case 'bulletin':
      _tannwald_bulletin_preprocess($variables, $node);
      break;
  }
}

/**
 * Implements hook_preprocess_HOOK() for breadcrumb templates.
 */
function tannwald_preprocess_breadcrumb(array &$variables): void {
  _tannwald_breadcrumb_prepare($variables);
}

/**
 * Implements hook_preprocess_HOOK() for views table templates.
 */
function tannwald_preprocess_views_view_table(array &$variables): void {
  if (isset($variables['view']) && $variables['view']->id() === 'portal_maschinen') {
    _tannwald_machine_cards($variables);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * Login im Theme: Felder ohne Hilfetexte, Button als Primäraktion.
 */
function tannwald_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['name']['#description'] = '';
  $form['name']['#attributes']['autocomplete'] = 'username';
  $form['pass']['#description'] = '';
  $form['pass']['#attributes']['autocomplete'] = 'current-password';
  $form['actions']['submit']['#attributes']['class'] = ['btn', 'btn-primary', 'w-full'];
}

/**
 * Implements hook_form_FORM_ID_alter() for tannwald_bulletin_confirm_form.
 *
 * Button „Gelesen bestätigen“ im Bulletin-Banner (Wireframe 01).
 */
function tannwald_form_tannwald_bulletin_confirm_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['actions']['submit']['#attributes']['class'] = ['btn', 'btn-warn'];
}
