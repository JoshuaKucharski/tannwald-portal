/**
 * Implements hook_theme().
 *
 * Theme-Hook der Styleguide-Seite; C's Controller gibt #theme
 * tannwald_styleguide zurück, das Template liegt im Theme.
 */
function tannwald_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'tannwald_styleguide' => [
      'variables' => [],
      'template' => 'styleguide',
      'path' => $path . '/templates',
    ],
  ];
}

