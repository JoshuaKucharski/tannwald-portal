<?php

/**
 * @file
 * Theme myTannwald: Preprocess-Hooks, Formular-Anpassungen (Aufgabe 5.1).
 *
 * Logik in includes/: layout.inc (Demo-Leiste, Kopfzeile, Brotkrumen),
 * machine.inc (Maschinenseite, Karten der Liste), document.inc (Dokument- und
 * Bulletinseite mit Kapitel-Ankern), search.inc (Suche 5.2), common.inc.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Json;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

require_once __DIR__ . '/includes/common.inc';
require_once __DIR__ . '/includes/layout.inc';
require_once __DIR__ . '/includes/machine.inc';
require_once __DIR__ . '/includes/document.inc';
require_once __DIR__ . '/includes/search.inc';

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function tannwald_preprocess_page(array &$variables): void {
  _tannwald_layout_prepare($variables);
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function tannwald_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  switch ($node->bundle()) {
    case 'maschine':
      _tannwald_machine_preprocess($variables, $node);
      break;

    case 'dokument':
      _tannwald_document_preprocess($variables, $node);
      break;

    case 'bulletin':
      _tannwald_bulletin_preprocess($variables, $node);
      break;
  }
}

/**
 * Implements hook_preprocess_HOOK() for status messages.
 *
 * Auf Nutzerseiten (Anmelden, Passwort) stehen Meldungen inline über dem
 * Formular statt als Toast.
 */
function tannwald_preprocess_status_messages(array &$variables): void {
  $variables['inline'] = in_array(\Drupal::routeMatch()->getRouteName(), _tannwald_user_routes(), TRUE);
}

/**
 * Implements hook_preprocess_HOOK() for breadcrumb templates.
 */
function tannwald_preprocess_breadcrumb(array &$variables): void {
  _tannwald_breadcrumb_prepare($variables);
}

/**
 * Implements hook_preprocess_HOOK() for views table templates.
 */
function tannwald_preprocess_views_view_table(array &$variables): void {
  if (isset($variables['view']) && $variables['view']->id() === 'portal_maschinen') {
    _tannwald_machine_cards($variables);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * Login im Theme: Felder ohne Hilfetexte, Button als Primäraktion.
 */
function tannwald_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['name']['#description'] = '';
  $form['name']['#attributes']['autocomplete'] = 'username';
  $form['name']['#attributes']['autofocus'] = 'autofocus';
  $form['pass']['#description'] = '';
  $form['pass']['#attributes']['autocomplete'] = 'current-password';
  // Passwort anzeigen (tw2-11 Nachtrag 5 (e)): Icon-Schalter Auge / durch-
  // gestrichenes Auge rechts im Feld, 44-px-Ziel, aria-pressed, Zustand
  // showPassword (Alpine); das Feld bekommt rechts Platz für den Schalter.
  $form['pass']['#attributes'][':type'] = "showPassword ? 'text' : 'password'";
  $form['pass']['#attributes']['class'][] = 'pr-12';
  $renderer = \Drupal::service('renderer');
  $icon = static fn (string $name, array $attributes): array => [
    '#type' => 'component',
    '#component' => 'tannwald:icon',
    '#props' => ['name' => $name, 'size' => 20],
    '#attributes' => $attributes,
  ];
  $icons = (string) $renderer->renderInIsolation($icon('eye', ['x-show' => '!showPassword']))
    . (string) $renderer->renderInIsolation($icon('eye-off', ['x-show' => 'showPassword', 'x-cloak' => '']));
  $form['pass']['#field_suffix'] = [
    '#type' => 'html_tag',
    '#tag' => 'button',
    '#value' => Markup::create($icons),
    '#attributes' => [
      'type' => 'button',
      'class' => ['login-pass-toggle'],
      '@click' => 'showPassword = !showPassword',
      'aria-label' => t('Show password'),
      ':aria-label' => 'showPassword ? ' . Json::encode((string) t('Hide password'))
      . ' : ' . Json::encode((string) t('Show password')),
      'aria-pressed' => 'false',
      ':aria-pressed' => "showPassword ? 'true' : 'false'",
      ':class' => "{ 'is-on': showPassword }",
      'aria-controls' => 'edit-pass',
    ],
  ];
  $form['actions']['submit']['#attributes']['class'] = ['btn', 'btn-primary', 'w-full'];
  // Fehlertext, der sagt, was zu tun ist (Leitplanken §5).
  $form['#validate'][] = '_tannwald_login_error_message';
}

/**
 * Ersetzt die Core-Fehlermeldung der Anmeldung durch einen klaren Satz.
 */
function _tannwald_login_error_message(array &$form, FormStateInterface $form_state): void {
  $errors = $form_state->getErrors();
  if ($errors === [] || !isset($errors['name'])) {
    return;
  }
  $form_state->clearErrors();
  $form_state->setErrorByName('name', t('Username or password do not match. Please check your entry.'));
}

