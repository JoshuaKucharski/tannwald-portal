{#
/**
 * @file
 * Textfeld (1.3): Feld-Muster input input--textarea; Fehler über aria-invalid.
 */
#}
{%
  set classes = [
    'form-textarea',
    'input',
    'input--textarea',
    resizable ? 'resize-' ~ resizable,
    required ? 'required',
  ]
%}
{% if attributes.hasClass('error') %}{% set attributes = attributes.setAttribute('aria-invalid', 'true') %}{% endif %}
<div{{ wrapper_attributes.addClass('form-textarea-wrapper') }}>
  <textarea{{ attributes.addClass(classes) }}>{{ value }}</textarea>
</div>
