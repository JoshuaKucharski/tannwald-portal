{#
/**
 * @file
 * Bulletinseite (1.2 auf das Design-System gehoben): Kopf mit Art, Datum und Bild (Bulletin, sonst Platzhalter),
 * Inhaltsverzeichnis haftend, Lesespalte mit Kapitel-Ankern (Zitate des Assistenten springen hierher).
 * Variablen aus tannwald_preprocess_node() (includes/document.inc): kind_label, published, requires_confirmation,
 * toc[], body, image, cache_bubble.
 */
#}
{{ cache_bubble }}
<article{{ attributes.addClass('flex flex-col gap-10') }}>
  {{ title_prefix }}{{ title_suffix }}
  <header class="head-split">
    <div class="flex min-w-0 flex-col gap-3">
      <span class="flex flex-wrap items-center gap-2">
        {{ include('tannwald:badge', {label: kind_label, variant: requires_confirmation ? 'warn' : 'neutral'}, with_context = false) }}
      </span>
      <h1 class="page-title">{{ label }}</h1>
      <p class="m-0 meta">
        {{ 'Published @date'|t({'@date': published}) }}
        {%- if requires_confirmation %} · {{ 'Read confirmation required'|t }}{% endif -%}
      </p>
      {% if requires_confirmation %}
        <p class="m-0 max-w-prose text-muted">{{ 'Confirm the reading on the page of the affected machine (button “Gelesen bestätigen”).'|t }}</p>
      {% endif %}
    </div>
    {% embed 'tannwald:figure' with {ratio: 'card', placeholder_label: 'No image available'|t, image: image} only %}
      {% block image %}{{ image }}{% endblock %}
    {% endembed %}
  </header>
  {# 6.1 (E): Moderations-Formular (Freigeben/Zurückweisen) auf /latest für redaktion und compliance. #}
  {% if content.content_moderation_control|render|trim %}
    <div class="card card-body">{{ content.content_moderation_control }}</div>
  {% endif %}
  <div class="doc-layout">
    {% if toc %}
      {{ include('tannwald:toc', {entries: toc}, with_context = false) }}
    {% else %}
      <span class="hidden lg:block" aria-hidden="true"></span>
    {% endif %}
    <div class="doc-main">
      <div class="prose-doc">{{ body }}</div>
    </div>
  </div>
</article>
