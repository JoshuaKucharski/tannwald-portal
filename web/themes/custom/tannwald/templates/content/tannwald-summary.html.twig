{#
/**
 * @file
 * Freigegebene Zusammenfassung am Dokument (Pseudo-Feld von 3.2, Modul tannwald_ingest; 1.2: abgesetzter Absatz
 * mit Akzentlinie statt Kasten). Variablen: body, generiert_am, modell, summary_nid.
 */
#}
<div data-summary-nid="{{ summary_nid }}">
  <h2 class="m-0 mb-2 text-sm font-medium text-muted">{{ 'Summary'|t({}, {'context': 'tannwald review'}) }}</h2>
  <blockquote class="doc-summary">{{ body }}</blockquote>
  <p class="doc-summary-meta m-0">{{ 'Generated @date with @model, approved by the editorial team.'|t({'@date': generiert_am, '@model': modell}) }}</p>
</div>
