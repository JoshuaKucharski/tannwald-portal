{#
/**
 * @file
 * Seitentitel (Block) — auf Maschinen- und Dokumentseiten ausgeblendet, dort zeigen die Node-Templates den Titel.
 */
#}
{{ title_prefix }}
{% if title %}
  <h1{{ title_attributes.addClass('m-0 mb-4 text-2xl font-semibold leading-display md:mb-6') }}>{{ title }}</h1>
{% endif %}
{{ title_suffix }}
