{#
/**
 * @file
 * Suche (1.3, Wireframe 02, Leitplanken v2; tw2-13): Seitenkopf, Suchfeld mit Live-Resultaten, Segment-Schalter
 * „Hybrid“ / „Nur Volltext“ und Filter-Chips wie im Such-Overlay (keine Seitenleiste, kein Sheet), Trefferzeile mit
 * Sortierung als Chip-Paar, Trefferkarten mit Thumb über die volle Breite, Leer-Zustände mit Beispielen; der Assistent
 * ist der globale Launcher (A, tw2-11 Nachtrag 6). Überschreibt das Fallback-Template von tannwald_assistant.
 *
 * Variablen aus 4.2/6.1 (query, modus, aktuell, filters, hits, facets, total, dauer_ms, pager, live_url, sort,
 * sort_urls) und aus tannwald_preprocess_tannwald_search_page() (includes/search.inc): form_id, modus_label,
 * duration_text, active_filters, facet_groups[] {name, label, param, items, reset_url}, reset_all_url,
 * maschine_nid, examples[] {label, url}, questions[], has_query, search_url, hit_images[nid], chat, chat_cache.
 */
#}
{{ chat_cache }}
<div class="tannwald-search search-page" data-search-page>
  <header class="page-head">
    <div>
      <h1 class="page-title">{{ 'Search your documents'|t }}</h1>
      <p class="page-meta">{{ 'Only documents you are allowed to see. Hybrid also finds hits by meaning.'|t }}</p>
    </div>
  </header>

  {# tw2-13: Ergebnisseite mit demselben Segment-Schalter und denselben Chips wie das Overlay; keine Seitenleiste mehr. #}
  <form id="{{ form_id }}" action="{{ search_url }}" method="get" role="search" class="search-form" x-data="{ modus: '{{ modus|e('js') }}', filtersOpen: {{ active_filters ? 'true' : 'false' }} }">
    <label for="tannwald-search-q" class="visually-hidden">{{ 'Search term'|t }}</label>
    <div class="search-form-row">
      {{ include('tannwald:search-live', {
        input_id: 'tannwald-search-q',
        live_url: live_url,
        modus_input: 'modus',
        query: query,
        maschine_nid: maschine_nid,
        placeholder: 'e.g. E-4711 or cleaning the sealing station'|t,
        attributes: create_attribute({'class': ['search-live']}),
      }, with_context = false) }}
      <button type="submit" class="btn btn-primary">{{ 'Search'|t({}, {'context': 'tannwald button'}) }}</button>
    </div>
    <input type="hidden" name="modus" value="{{ modus }}" :value="modus">
    <div class="search-tools-row">
      <div role="radiogroup" aria-label="{{ 'Search mode'|t }}" class="segment" data-search-modes
        @keydown.arrow-left.prevent="modus = modus === 'hybrid' ? 'volltext' : 'hybrid'; $nextTick(() => $el.form.requestSubmit())"
        @keydown.arrow-right.prevent="modus = modus === 'hybrid' ? 'volltext' : 'hybrid'; $nextTick(() => $el.form.requestSubmit())">
        <button type="button" role="radio" class="segment-item" :aria-checked="modus === 'hybrid' ? 'true' : 'false'" :tabindex="modus === 'hybrid' ? 0 : -1" @click="modus = 'hybrid'; $nextTick(() => $el.form.requestSubmit())" data-modus="hybrid">{{ 'Hybrid'|t }}</button>
        <button type="button" role="radio" class="segment-item" :aria-checked="modus === 'volltext' ? 'true' : 'false'" :tabindex="modus === 'volltext' ? 0 : -1" @click="modus = 'volltext'; $nextTick(() => $el.form.requestSubmit())" data-modus="volltext">{{ 'Full text only'|t }}</button>
      </div>
      {# Phone: Chips hinter „Filter (n)“ (gemessen 308 px für 14 Chips bei 390); ab md immer sichtbar. #}
      <button type="button" class="btn btn-secondary md:hidden" aria-controls="search-chips" :aria-expanded="filtersOpen ? 'true' : 'false'" @click="filtersOpen = !filtersOpen" data-filters-toggle>
        {{ include('tannwald:icon', {name: 'filter', size: 20}, with_context = false) }}
        <span>{{ active_filters ? 'Filter (@count)'|t({'@count': active_filters}) : 'Filter'|t }}</span>
      </button>
      {% if active_filters and reset_all_url %}
        <a href="{{ reset_all_url }}" class="btn-text text-sm" data-reset-all>{{ 'Reset all'|t }}</a>
      {% endif %}
    </div>
    {# Filter als Chips (Checkboxen senden das Formular ab); Zähler je Facette aus dem Controller, nur mit Suchbegriff. #}
    <div id="search-chips" class="search-chips" :class="{ 'is-open': filtersOpen }" role="group" aria-label="{{ 'Filter'|t }}" data-search-chips>
      <label class="chip chip--check">
        <input type="checkbox" name="aktuell" value="1" class="visually-hidden"{{ aktuell ? ' checked' }} @change="$el.form.requestSubmit()">
        <span>{{ 'Current versions only'|t }}</span>
      </label>
      {% for group in facet_groups %}
        {% if group.items %}
          <fieldset class="search-chip-group" data-facet="{{ group.name }}">
            <legend class="visually-hidden">{{ group.label }}</legend>
            {% for item in group.items %}
              <label class="chip chip--check" title="{{ group.label }}">
                <input type="checkbox" name="{{ group.param }}" value="{{ item.id }}" class="visually-hidden"{{ item.active ? ' checked' }} @change="$el.form.requestSubmit()">
                <span>{{ item.label }}</span>
                <span class="count num text-muted">{{ item.count }}</span>
              </label>
            {% endfor %}
          </fieldset>
        {% endif %}
      {% endfor %}
    </div>
    {% if maschine_nid %}<input type="hidden" name="maschine_nid" value="{{ maschine_nid }}">{% endif %}
    {% if sort == 'datum' %}<input type="hidden" name="sort" value="datum">{% endif %}
  </form>

  <div class="search-layout">
    <section aria-label="{{ 'Search results'|t }}" class="search-results">
      {% if has_query %}
        <div class="search-results-head">
          <p class="m-0 text-sm text-muted" data-search-summary>
            <strong class="text-ink">{{ total == 1 ? '1 hit'|t : '@total hits'|t({'@total': total}) }}</strong>
            {{ 'in @seconds s'|t({'@seconds': duration_text}) }} · {{ 'Mode @modus'|t({'@modus': modus_label}) }}
          </p>
          <div class="search-tools">
            {# 6.1 (E): Sortierung Relevanz/Datum (Wireframe 02), Links aus dem Controller; 1.3: Chip-Paar. #}
            {% if sort_urls %}
              <nav class="search-sort tannwald-search__sort" aria-label="{{ 'Sort by'|t }}" data-search-sort>
                <span class="text-sm text-muted">{{ 'Sort by'|t }}</span>
                <a href="{{ sort_urls.relevanz }}" class="chip{{ sort == 'relevanz' ? ' is-selected' : '' }}"{{ sort == 'relevanz' ? ' aria-current="true"' }}>{{ 'Relevance'|t }}</a>
                <a href="{{ sort_urls.datum }}" class="chip{{ sort == 'datum' ? ' is-selected' : '' }}"{{ sort == 'datum' ? ' aria-current="true"' }}>{{ 'Date'|t }}</a>
              </nav>
            {% endif %}
          </div>
        </div>
        {% if hits %}
          <ol class="tannwald-search__hits search-hits">
            {% for hit in hits %}
              {% embed 'tannwald:search-hit' with {
                nid: hit.nid, titel: hit.titel, heading_path: hit.heading_path, langcode: hit.langcode,
                dokumenttyp: hit.dokumenttyp, maschinentypen: hit.maschinentypen, version: hit.version,
                freigegeben_am: hit.freigegeben_am, url_kapitel: hit.url_kapitel, url_dokument: hit.url_dokument,
                url_maschine: hit.url_maschine, maschine_titel: hit.maschine_titel, matched_by: hit.matched_by,
                bulletin_bestaetigt_am: hit.bulletin_bestaetigt_am, attributes: create_attribute(),
                image: hit_images[hit.nid]|default(null),
              } only %}
                {% block snippet %}{{ hit.snippet_html }}{% endblock %}
                {% block image %}{% if image %}{{ image }}{% endif %}{% endblock %}
              {% endembed %}
            {% endfor %}
          </ol>
        {% else %}
          <div class="empty-state" data-search-empty>
            <p class="empty-state-title">{{ 'No hits for “@query”.'|t({'@query': query}) }}</p>
            <p class="empty-state-text">{{ 'Try another spelling, switch to Hybrid, or ask the assistant.'|t }}</p>
            <div class="search-examples" data-search-questions>
              {% for question in questions %}
                <button type="button" class="chip" @click="$dispatch('tannwald:ask', { frage: {{ question|json_encode }} })">{{ question }}</button>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="empty-state" data-search-hint>
          <p class="empty-state-title">{{ 'Enter a search term.'|t }}</p>
          <p class="empty-state-text">{{ 'Examples: a fault code, a part, an activity.'|t }}</p>
          <div class="search-examples" data-search-examples>
            {% for example in examples %}<a href="{{ example.url }}" class="chip">{{ example.label }}</a>{% endfor %}
          </div>
          {# Nachtrag 6 (tw2-11): ein Satz mit Button, der den globalen Launcher öffnet (Ereignis tannwald:chat-open). #}
          <p class="empty-state-text mt-2" x-data>{{ 'Or ask the assistant:'|t }} <button type="button" class="btn-text" @click="$dispatch('tannwald:chat-open')">{{ 'Open the assistant'|t }}</button></p>
        </div>
      {% endif %}

      {% if has_query and hits %}
        {{ pager }}
        {# 5.3: chat-bridge — nach den Treffern: Frage an den Assistenten mit dem Suchbegriff. #}
        <div class="flex flex-wrap items-center gap-4 rounded-card border border-dashed border-line px-4 py-4 md:px-6" data-chat-bridge data-question="{{ query }}" x-data>
          <span class="flex-1 basis-80 text-sm text-muted">{{ 'Prefer an answer instead of a list of hits? The assistant summarises the matching chapters and cites them.'|t }}</span>
          <button type="button" class="btn btn-secondary" @click="$dispatch('tannwald:ask', { frage: $el.closest('[data-chat-bridge]').dataset.question })">{{ 'Ask the assistant'|t }}</button>
        </div>
      {% endif %}
    </section>

    {# Nachtrag 6 (tw2-11): keine eingebettete Assistenten-Spalte mehr — der globale Launcher übernimmt. #}
  </div>
</div>
