{#
/**
 * @file
 * Tabelle „Kosten je Monat“ (1.3): Zeilenraster, Zahlen rechtsbündig (Tokens, Kosten CHF mit zwei Stellen,
 * Anteil am Monatslimit). Spaltenschlüssel: period_month, tokens_total, kosten_chf, limit_share.
 */
#}
{% set numeric = ['tokens_total', 'kosten_chf', 'limit_share'] %}
<div class="admin-table-wrap">
<table{{ attributes.addClass('admin-table', 'views-table') }}>
  {% if caption_needed %}<caption>{{ caption ?: title }}</caption>{% endif %}
  <thead>
    <tr>
      {% for key, column in header %}
        <th scope="col"{{ column.attributes.removeAttribute('class').addClass(key in numeric ? 'num' : '') }}>{{ column.content }}{{ column.sort_indicator }}</th>
      {% endfor %}
    </tr>
  </thead>
  <tbody>
    {% for row in rows %}
      <tr{{ row.attributes }}>
        {% for key, column in row.columns %}
          <td{{ column.attributes.removeAttribute('class').addClass(key in numeric ? 'num' : 'whitespace-nowrap') }}>
            {%- for content in column.content %}{{ content.separator }}{{ content.field_output }}{% endfor -%}
          </td>
        {% endfor %}
      </tr>
    {% endfor %}
  </tbody>
</table>
</div>
