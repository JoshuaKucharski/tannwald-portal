{#
/**
 * @file
 * „Meine Maschinen“ als Kartenraster (View portal_maschinen, Tabellenstil bleibt Konfiguration von 2.1).
 * 1.2: Karte = SDC tannwald:machine-card mit Typbild (Slot image aus tannwald_image()).
 * Variablen aus tannwald_preprocess_views_view_table(): cards[] {image, serial, url, type_name, location, year,
 * contract_label, contract_until, documents_current, documents_new, bulletins_open, bulletins_confirmed}, cache_bubble.
 */
#}
{{ cache_bubble }}
<div class="machine-grid" data-machine-cards>
  {% for card in cards %}
    {% embed 'tannwald:machine-card' with {
      serial: card.serial,
      url: card.url,
      type_name: card.type_name,
      location: card.location,
      year: card.year ? card.year|e : null,
      documents_current: card.documents_current,
      documents_new: card.documents_new,
      bulletins_open: card.bulletins_open,
      image: card.image,
    } only %}
      {% block image %}{{ image }}{% endblock %}
    {% endembed %}
  {% else %}
    <div class="empty-state md:col-span-2 xl:col-span-3">
      <p class="empty-state-title">{{ 'No machines yet'|t }}</p>
      <p class="empty-state-text">{{ 'No machines are assigned to your company yet. Your Tannwald contact links them to your account; type documents are available through the search.'|t }}</p>
      <a class="btn btn-secondary mt-2" href="{{ path('tannwald_assistant.search') }}">{{ 'Search'|t }}</a>
    </div>
  {% endfor %}
</div>
