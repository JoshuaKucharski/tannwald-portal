{#
/**
 * @file
 * Zeilen der Bulletin-Liste (/bulletins): unverändert die Felder der View; für die Redaktion folgt je Bulletin
 * die Lese-Quote (1.3, Wireframe 03 „Bulletins“): bestätigt / fällig mit Balken und Link zu den Bestätigungen.
 * quotas[] aus tannwald_preprocess_views_view_unformatted__portal_bulletins() (includes/redaktion.inc).
 */
#}
{% for row in rows %}
  {% set row_classes = [default_row_class ? 'views-row'] %}
  <div{{ row.attributes.addClass(row_classes) }}>
    {{- row.content -}}
    {% set quota = quotas[loop.index0]|default(null) %}
    {% if quota %}
      <div class="bulletin-quota mt-2" data-read-quota="{{ quota.confirmed }}/{{ quota.total }}">
        <span class="bulletin-quota-bar" aria-hidden="true"><span class="bulletin-quota-fill" style="width: {{ quota.percent }}%"></span></span>
        <span>{{ 'Read confirmations: @confirmed of @total'|t({'@confirmed': quota.confirmed, '@total': quota.total}) }}</span>
        {% if quota.url %}<a href="{{ quota.url }}">{{ 'Show confirmations'|t }}</a>{% endif %}
      </div>
    {% endif %}
  </div>
{% endfor %}
