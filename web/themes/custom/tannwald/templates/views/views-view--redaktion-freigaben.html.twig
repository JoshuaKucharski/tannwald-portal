{#
/**
 * @file
 * Freigabe-Queue (Wireframe 03, 1.3): Seitenkopf mit Satz, Reiter mit Zählern (Area tannwald_review_counts, D),
 * Review-Karten, Leer-Zustand als Aufforderung, Pager.
 */
#}
<div{{ attributes.addClass('view', 'view-redaktion-freigaben', 'flex', 'flex-col', 'gap-6') }}>
  {{ title_prefix }}{{ title_suffix }}
  <p class="page-meta">{{ 'Summaries become visible on the document, in search and in the assistant only after approval.'|t }}</p>
  {% if header %}<div class="view-header">{{ header }}</div>{% endif %}
  {% if rows %}
    <div class="view-content flex flex-col gap-6">{{ rows }}</div>
  {% elseif empty %}
    <div class="view-empty empty-state" data-review-empty>
      <p class="empty-state-title">{{ 'Nothing to review.'|t }}</p>
      <p class="empty-state-text">{{ 'As soon as the queue generates a summary for a new document revision, it appears here.'|t }}</p>
    </div>
  {% endif %}
  {% if pager %}{{ pager }}{% endif %}
  {% if footer %}<div class="view-footer">{{ footer }}</div>{% endif %}
</div>
