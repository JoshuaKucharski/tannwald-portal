{#
/**
 * @file
 * „Nutzung und Kosten: Kosten je Monat“ (1.3, Portal-Theme unter /redaktion/kosten): Satz, Tabelle,
 * Leer-Zustand. Kosten CHF mit zwei Stellen und ’ kommen aus der View (Feld kosten_chf).
 */
#}
<div{{ attributes.addClass('view', 'view-admin-kosten', 'admin-page') }}>
  {{ title_prefix }}{{ title_suffix }}
  <p class="page-meta">{{ 'Tokens, costs in CHF and share of the monthly limit, per month.'|t }}</p>
  {% if header %}<div class="view-header">{{ header }}</div>{% endif %}
  {% if rows %}
    <div class="view-content">{{ rows }}</div>
  {% elseif empty %}
    <div class="view-empty empty-state">
      <p class="empty-state-title">{{ 'No costs yet.'|t }}</p>
      <p class="empty-state-text">{{ 'As soon as the assistant answers, tokens and costs appear here per month.'|t }}</p>
    </div>
  {% endif %}
  {% if pager %}{{ pager }}{% endif %}
  {% if footer %}<div class="view-footer">{{ footer }}</div>{% endif %}
</div>
