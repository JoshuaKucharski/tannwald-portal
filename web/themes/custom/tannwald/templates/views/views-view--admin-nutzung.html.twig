{#
/**
 * @file
 * „Nutzung und Kosten: Nutzung je Tag“ (1.3, Portal-Theme unter /redaktion/nutzung): Satz, Zeitraum als
 * Chip-Trio (30 / 90 / 365 Tage, exponierter Filter zeitraum), Kennzahlen-Kopf (Area tannwald_answer_stats),
 * Tabelle, Leer-Zustand. periods[] {label, url, active} aus tannwald_preprocess_views_view__admin_nutzung()
 * (includes/admin.inc). Die exponierte Form selbst wird nicht gedruckt: die Chips sind ihre Oberfläche.
 */
#}
<div{{ attributes.addClass('view', 'view-admin-nutzung', 'admin-page') }}>
  {{ title_prefix }}{{ title_suffix }}
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <p class="page-meta">{{ 'Calls and tokens of the assistant per day, context and operation.'|t }}</p>
    {% if periods %}
      <nav class="admin-period" aria-label="{{ 'Period'|t }}" data-admin-period>
        <span class="text-sm text-muted">{{ 'Period'|t }}</span>
        {% for period in periods %}
          <a href="{{ period.url }}" class="chip{{ period.active ? ' is-selected' : '' }}"{% if period.active %} aria-current="true"{% endif %}>{{ period.label }}</a>
        {% endfor %}
      </nav>
    {% endif %}
  </div>
  {% if header %}<div class="view-header admin-stats">{{ header }}</div>{% endif %}
  {% if rows %}
    <div class="view-content">{{ rows }}</div>
  {% elseif empty %}
    <div class="view-empty empty-state">
      <p class="empty-state-title">{{ 'No usage in this period.'|t }}</p>
      <p class="empty-state-text">{{ 'As soon as the assistant answers, calls and tokens appear here.'|t }}</p>
    </div>
  {% endif %}
  {% if pager %}{{ pager }}{% endif %}
  {% if footer %}<div class="view-footer">{{ footer }}</div>{% endif %}
</div>
