{#
/**
 * @file
 * Statusmeldungen: als Toast oben rechts („Lesebestätigung gespeichert.“, Alpine blendet nach 8 s aus) oder inline
 * im Fluss (Anmeldeseite, Variable inline aus tannwald_preprocess_status_messages). Ohne JavaScript bleiben die
 * Meldungen sichtbar. Klassen toast / notice mit Farbwelt ok / warn / danger (Design-System v2).
 */
#}
{% if message_list %}
{% set tone = { status: 'ok', warning: 'warn', error: 'danger' } %}
{% if inline %}
<div data-drupal-messages class="mb-4 flex flex-col gap-2">
{% for type, messages in message_list %}
  <div role="{{ type == 'error' ? 'alert' : 'status' }}" aria-label="{{ status_headings[type] }}" class="notice notice--{{ tone[type]|default('neutral') }}">
    {% if messages|length > 1 %}
      <ul class="m-0 list-disc pl-4">{% for message in messages %}<li>{{ message }}</li>{% endfor %}</ul>
    {% else %}
      {{ messages|first }}
    {% endif %}
  </div>
{% endfor %}
</div>
{% else %}
<div data-drupal-messages class="toast-stack">
{% for type, messages in message_list %}
  <div x-data="toast" x-show="open" x-transition.opacity.duration.180ms role="{{ type == 'error' ? 'alert' : 'status' }}" aria-label="{{ status_headings[type] }}" class="toast toast--{{ tone[type]|default('neutral') }}">
    <div class="flex-1">
      {% if messages|length > 1 %}
        <ul class="m-0 list-disc pl-4">{% for message in messages %}<li>{{ message }}</li>{% endfor %}</ul>
      {% else %}
        {{ messages|first }}
      {% endif %}
    </div>
    <button type="button" class="btn-text btn-icon -my-2 -mr-2 h-11 w-11 justify-center" aria-label="{{ 'Close message'|t }}" @click="open = false">{{ include('tannwald:icon', {name: 'close'}, with_context = false) }}</button>
  </div>
{% endfor %}
</div>
{% endif %}
{% endif %}
