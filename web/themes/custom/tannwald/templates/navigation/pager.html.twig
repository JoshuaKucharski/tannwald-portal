{#
/**
 * @file
 * Pager (Core #type pager) im Theme: Seitenzahlen, „Zurück“ und „Weiter“ (Wireframe 02); Query-Parameter bleiben.
 */
#}
{% if items %}
  <nav class="pager" aria-labelledby="{{ heading_id }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="visually-hidden">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="pager__items js-pager__items">
      {% if items.previous %}
        <li class="pager__item pager__item--previous">
          <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}>{{ 'Back'|t({}, {'context': 'tannwald pager'}) }}</a>
        </li>
      {% endif %}
      {% if ellipses.previous %}
        <li class="pager__item pager__item--ellipsis px-1 text-muted" role="presentation">&hellip;</li>
      {% endif %}
      {% for key, item in items.pages %}
        <li class="pager__item{{ current == key ? ' is-active' : '' }}">
          <a href="{{ item.href }}" title="{{ current == key ? 'Current page'|t : 'Go to page @key'|t({'@key': key}) }}"{{ item.attributes|without('href', 'title') }}{% if current == key %} aria-current="page"{% endif %}>
            <span class="visually-hidden">{{ 'Page'|t }}</span>{{- key -}}
          </a>
        </li>
      {% endfor %}
      {% if ellipses.next %}
        <li class="pager__item pager__item--ellipsis px-1 text-muted" role="presentation">&hellip;</li>
      {% endif %}
      {% if items.next %}
        <li class="pager__item pager__item--next">
          <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}>{{ 'Next'|t({}, {'context': 'tannwald pager'}) }}</a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
