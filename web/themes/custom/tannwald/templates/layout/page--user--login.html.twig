{#
/**
 * @file
 * Anmeldeseite im Theme: Wortmarke, Formular (Benutzername, Passwort, Anmelden), Hinweis auf Demo-Konten
 * nur, wenn masquerade aktiv ist (Split dev). Variablen: site_name, demo_hint, cache_bubble.
 */
#}
{{ cache_bubble }}
<div class="flex min-h-screen flex-col items-center justify-center px-4 py-10">
  <div class="w-full max-w-md">
    <div class="mb-6 text-center">
      <span class="text-2xl font-bold text-accent">{{ site_name }}</span>
      <p class="meta mt-1">{{ 'Customer portal of Tannwald Verpackungstechnik AG'|t }}</p>
    </div>
    <div class="card px-6 py-6">
      {{ page.content }}
    </div>
    {% if demo_hint %}
      <p class="meta mt-4 text-center">{{ 'Demo accounts: @accounts · password @password'|t({'@accounts': 'kunde-a, kunde-b, haendler, techniker, redaktion, compliance', '@password': 'demo'}) }}</p>
    {% endif %}
  </div>
</div>
