{#
/**
 * @file
 * Seitenlayout (Wireframe 01 oben): Demo-Leiste, Kopfzeile mit Wortmarke, Hauptnavigation und Konto,
 * Brotkrumen, Inhalt, Seitenleiste, Fusszeile.
 *
 * Variablen aus tannwald_preprocess_page(): site_name, nav {home_url, items[] {label, url, active}},
 * account {display_name, company, initials, logout} oder null, demo {account_name, company, role_label,
 * switch_links[] {label, url}, back_url, back_name} oder null, error_page {code, title, text, back_url, back_label} oder null
 * (1.2), cache_bubble.
 */
#}
{{ cache_bubble }}
<div class="flex min-h-screen flex-col">
  {% if demo %}
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 bg-bar px-4 py-2 text-sm text-white md:px-8" data-demo-bar>
      <span class="font-semibold">{{ 'Demo mode'|t }}</span>
      <span>{{ 'logged in as'|t }} <strong>{{ demo.account_name }}</strong>{% if demo.company %} · {{ demo.company }}{% endif %} · {{ 'Role @role'|t({'@role': demo.role_label}) }}</span>
      {% if demo.switch_links %}
        <span class="text-bar-muted md:ml-auto">{{ 'Switch:'|t }}</span>
        {% for link in demo.switch_links %}
          <a href="{{ link.url }}" class="text-white underline hover:text-white" title="{{ link.title }}">{{ link.label }}</a>
        {% endfor %}
      {% endif %}
      {% if demo.back_url %}
        <a href="{{ demo.back_url }}" class="text-white underline hover:text-white{{ demo.switch_links ? '' : ' md:ml-auto' }}">{{ 'Back to @name'|t({'@name': demo.back_name}) }}</a>
      {% endif %}
    </div>
  {% endif %}
  {{ page.demo_bar }}

  <header class="site-header border-b border-line bg-panel">
    <div class="mx-auto flex max-w-page flex-wrap items-center gap-x-8 gap-y-1 px-4 py-2 md:min-h-16 md:px-8 md:py-0">
      <a href="{{ nav.home_url }}" class="text-lg font-semibold text-accent no-underline hover:text-accent-hover">{{ site_name }}</a>
      <nav aria-label="{{ 'Main navigation'|t }}" class="flex flex-wrap gap-x-6 font-medium">
        {% for item in nav.items %}
          <a href="{{ item.url }}" class="py-2 no-underline md:py-5 {{ item.active ? 'border-b-2 border-accent text-ink' : 'text-muted hover:text-ink' }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
        {# 5.3: hier anhängen (Redaktion) #}
        {% if redaktion_link %}
          <a href="{{ redaktion_link.url }}" class="py-2 no-underline md:py-5 {{ redaktion_link.active ? 'border-b-2 border-accent text-ink' : 'text-muted hover:text-ink' }}"{% if redaktion_link.active %} aria-current="page"{% endif %}>{{ redaktion_link.label }}</a>
        {% endif %}
      </nav>
      {{ page.primary_menu }}
      {% if account %}
        <div class="flex items-center gap-4 text-sm md:ml-auto">
          <span class="text-muted">{{ account.display_name }}{% if account.company %} · {{ account.company }}{% endif %}</span>
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-private-bg text-sm font-semibold text-accent" aria-hidden="true">{{ account.initials }}</span>
          {{ account.logout }}
        </div>
      {% endif %}
      {{ page.header }}
    </div>
  </header>

  <main id="main-content" class="mx-auto flex w-full max-w-page flex-1 flex-col gap-6 px-4 pb-12 pt-6 md:px-8">
    {{ page.breadcrumb }}
    {# 1.2: Fehlerseiten 403/404 als Leer-Zustand mit Weg zurück (error_page aus layout.inc). #}
    {% if error_page %}
      <div class="flex flex-col gap-6" data-error-page="{{ error_page.code }}">
        <h1 class="page-title">{{ error_page.title }}</h1>
        <div class="empty-state">
          <p class="empty-state-text">{{ error_page.text }}</p>
          <a href="{{ error_page.back_url }}" class="btn btn-secondary mt-2">{{ include('tannwald:icon', {name: 'arrow', size: 18, attributes: create_attribute({'class': ['rotate-180']})}, with_context = false) }}{{ error_page.back_label }}</a>
        </div>
      </div>
    {% endif %}
    {{ page.content }}
    {{ page.sidebar }}
  </main>

  {% if page.footer %}
    <footer class="border-t border-line bg-panel">
      <div class="mx-auto max-w-page px-4 py-4 text-sm text-muted md:px-8">{{ page.footer }}</div>
    </footer>
  {% endif %}
  {# 5.3: hier anhängen #}
  {{ chat_cache }}
  {% if chat %}{{ include('tannwald:chat', chat, with_context = false) }}{% endif %}
  {# 1.3: hier anhängen #}
</div>
