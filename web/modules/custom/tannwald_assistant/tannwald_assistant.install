<?php

/**
 * @file
 * Schema des Moduls tannwald_assistant (Assistent-Log, Pflichtenheft §5.4).
 */

declare(strict_types=1);

use Drupal\Core\Config\FileStorage;
use Drupal\tannwald_assistant\AnswerService;
use Drupal\views\Entity\View;

/**
 * Implements hook_schema().
 */
function tannwald_assistant_schema(): array {
  $schema['tannwald_assistant_log'] = [
    'description' => 'Pseudonymised assistant log (FA-AI-07): one row per answer.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'session_hash' => [
        'description' => 'sha256 of the session id plus site hash salt.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'uid_hash' => [
        'description' => 'sha256 of the uid plus site hash salt.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'langcode' => [
        'type' => 'varchar_ascii',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
      ],
      'frage' => [
        'type' => 'text',
        'not null' => TRUE,
      ],
      'antwort' => [
        'type' => 'text',
        'size' => 'medium',
        'not null' => TRUE,
      ],
      'quellen' => [
        'description' => 'JSON list of cited sources {n, nid, titel, version, heading_path, url}.',
        'type' => 'text',
        'not null' => TRUE,
      ],
      'status' => [
        'description' => 'beantwortet, abgelehnt, safety or limit.',
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
        'default' => '',
      ],
      'bewertung' => [
        'description' => 'Feedback 1 or -1 (filled by 4.2), NULL without feedback.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => FALSE,
      ],
      'dauer_ms' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ] + tannwald_assistant_log_fields_4_2() + [
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'created' => ['created'],
      'status_created' => ['status', 'created'],
      'uid_hash' => ['uid_hash'],
      'session_hash' => ['session_hash'],
      'frage_normalisiert' => ['frage_normalisiert'],
    ],
  ];
  return $schema;
}

/**
 * Spalten aus 4.2 (TC-16, Unbeantwortete Fragen).
 *
 * @return array<string, array<string, mixed>>
 *   Feld-Definitionen für hook_schema() und hook_update_10001().
 */
function tannwald_assistant_log_fields_4_2(): array {
  return [
    'injection_verdacht' => [
      'description' => 'Number of context chunks matching an injection pattern (TC-16).',
      'type' => 'int',
      'size' => 'small',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ],
    'maschine_nid' => [
      'description' => 'Machine node the question was asked for, NULL without machine.',
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => FALSE,
    ],
    'frage_normalisiert' => [
      'description' => 'Question lowercased, whitespace collapsed, for grouping.',
      'type' => 'varchar',
      'length' => 255,
      'not null' => TRUE,
      'default' => '',
    ],
  ];
}

/**
 * Log: Spalten injection_verdacht, maschine_nid, frage_normalisiert.
 */
function tannwald_assistant_update_10001(): string {
  $schema = \Drupal::database()->schema();
  foreach (tannwald_assistant_log_fields_4_2() as $name => $spec) {
    if (!$schema->fieldExists('tannwald_assistant_log', $name)) {
      $schema->addField('tannwald_assistant_log', $name, $spec);
    }
  }
  foreach (['session_hash' => ['session_hash'], 'frage_normalisiert' => ['frage_normalisiert']] as $index => $fields) {
    if (!$schema->indexExists('tannwald_assistant_log', $index)) {
      $schema->addIndex('tannwald_assistant_log', $index, $fields, tannwald_assistant_schema()['tannwald_assistant_log']);
    }
  }
  return 'tannwald_assistant_log: injection_verdacht, maschine_nid, frage_normalisiert added.';
}

/**
 * Entity support_anfrage installieren.
 */
function tannwald_assistant_update_10002(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('support_anfrage') === NULL) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('support_anfrage'));
  }
  return 'Entity type support_anfrage installed.';
}

/**
 * Views (config/optional): Unbeantwortete Fragen, Nutzung, Kosten, Support.
 */
function tannwald_assistant_update_10003(): string {
  $path = \Drupal::service('extension.list.module')->getPath('tannwald_assistant') . '/config/optional';
  \Drupal::service('config.installer')->installOptionalConfig(new FileStorage($path));
  return 'Optional views of tannwald_assistant installed (if roles and views exist).';
}

/**
 * Unbeantwortete Fragen: Filter „laufender Monat“ statt Views-Offset.
 */
function tannwald_assistant_update_10004(): string {
  $path = \Drupal::service('extension.list.module')->getPath('tannwald_assistant') . '/config/optional';
  $data = (new FileStorage($path))->read('views.view.redaktion_unbeantwortet');
  $view = View::load('redaktion_unbeantwortet');
  if ($view === NULL || !is_array($data)) {
    return 'View redaktion_unbeantwortet not present; nothing to do.';
  }
  $view->set('display', $data['display'])->save();
  return 'View redaktion_unbeantwortet: filter current month.';
}

/**
 * Log: frage_normalisiert für Zeilen aus der Zeit vor 4.2 nachtragen.
 */
function tannwald_assistant_update_10005(): string {
  $database = \Drupal::database();
  $rows = $database->select('tannwald_assistant_log', 'l')
    ->fields('l', ['id', 'frage'])
    ->condition('frage_normalisiert', '')
    ->execute()
    ->fetchAllKeyed();
  foreach ($rows as $id => $frage) {
    $database->update('tannwald_assistant_log')
      ->fields(['frage_normalisiert' => AnswerService::normalizeQuestion((string) $frage)])
      ->condition('id', $id)
      ->execute();
  }
  return sprintf('frage_normalisiert filled for %d log rows.', count($rows));
}

/**
 * Setzt Provider je Operation und Modelle/Kosten je Provider (3.1).
 *
 * Flach provider/chat_model/embedding_model/kosten_pro_1k_chf → provider_chat,
 * provider_embeddings, providers.<id>.*; bestehende Werte bleiben beim
 * bisherigen Provider, DashScope bekommt die Vorgaben aus config/install.
 */
function tannwald_assistant_update_10006(): string {
  $config = \Drupal::configFactory()->getEditable('tannwald_assistant.settings');
  if ($config->get('providers') !== NULL) {
    return 'tannwald_assistant.settings already has providers.';
  }
  $install = (new FileStorage(__DIR__ . '/config/install'))->read('tannwald_assistant.settings');
  $providers = $install['providers'];
  $current = (string) ($config->get('provider') ?: 'ollama');
  if (isset($providers[$current])) {
    $providers[$current]['chat_model'] = (string) ($config->get('chat_model') ?: $providers[$current]['chat_model']);
    $providers[$current]['embedding_model'] = (string) ($config->get('embedding_model') ?: $providers[$current]['embedding_model']);
    $providers[$current]['kosten_pro_1k_chf'] = (float) ($config->get('kosten_pro_1k_chf') ?? 0.0);
  }
  $config
    ->set('provider_chat', isset($providers[$current]) ? $current : 'ollama')
    ->set('provider_embeddings', isset($providers[$current]) ? $current : 'ollama')
    ->set('providers', $providers)
    ->clear('provider')
    ->clear('chat_model')
    ->clear('embedding_model')
    ->clear('kosten_pro_1k_chf')
    ->save();
  return sprintf('Providers per operation set (chat and embeddings: %s).', $config->get('provider_chat'));
}
