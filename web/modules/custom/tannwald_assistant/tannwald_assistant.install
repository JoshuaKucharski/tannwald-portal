<?php

/**
 * @file
 * Schema des Moduls tannwald_assistant (Assistent-Log, Pflichtenheft §5.4).
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function tannwald_assistant_schema(): array {
  $schema['tannwald_assistant_log'] = [
    'description' => 'Pseudonymised assistant log (FA-AI-07): one row per answer.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'session_hash' => [
        'description' => 'sha256 of the session id plus site hash salt.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'uid_hash' => [
        'description' => 'sha256 of the uid plus site hash salt.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'langcode' => [
        'type' => 'varchar_ascii',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
      ],
      'frage' => [
        'type' => 'text',
        'not null' => TRUE,
      ],
      'antwort' => [
        'type' => 'text',
        'size' => 'medium',
        'not null' => TRUE,
      ],
      'quellen' => [
        'description' => 'JSON list of cited sources {n, nid, titel, version, heading_path, url}.',
        'type' => 'text',
        'not null' => TRUE,
      ],
      'status' => [
        'description' => 'beantwortet, abgelehnt, safety or limit.',
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
        'default' => '',
      ],
      'bewertung' => [
        'description' => 'Feedback 1 or -1 (filled by 4.2), NULL without feedback.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => FALSE,
      ],
      'dauer_ms' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'created' => ['created'],
      'status_created' => ['status', 'created'],
      'uid_hash' => ['uid_hash'],
    ],
  ];
  return $schema;
}
