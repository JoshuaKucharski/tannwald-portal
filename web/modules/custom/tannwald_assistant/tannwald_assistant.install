<?php

/**
 * @file
 * Schema des Moduls tannwald_assistant (Assistent-Log, Pflichtenheft §5.4).
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function tannwald_assistant_schema(): array {
  $schema['tannwald_assistant_log'] = [
    'description' => 'Pseudonymised assistant log (FA-AI-07): one row per answer.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'session_hash' => [
        'description' => 'sha256 of the session id plus site hash salt.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'uid_hash' => [
        'description' => 'sha256 of the uid plus site hash salt.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'langcode' => [
        'type' => 'varchar_ascii',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
      ],
      'frage' => [
        'type' => 'text',
        'not null' => TRUE,
      ],
      'antwort' => [
        'type' => 'text',
        'size' => 'medium',
        'not null' => TRUE,
      ],
      'quellen' => [
        'description' => 'JSON list of cited sources {n, nid, titel, version, heading_path, url}.',
        'type' => 'text',
        'not null' => TRUE,
      ],
      'status' => [
        'description' => 'beantwortet, abgelehnt, safety or limit.',
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
        'default' => '',
      ],
      'bewertung' => [
        'description' => 'Feedback 1 or -1 (filled by 4.2), NULL without feedback.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => FALSE,
      ],
      'dauer_ms' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ] + tannwald_assistant_log_fields_4_2() + [
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'created' => ['created'],
      'status_created' => ['status', 'created'],
      'uid_hash' => ['uid_hash'],
      'session_hash' => ['session_hash'],
      'frage_normalisiert' => ['frage_normalisiert'],
    ],
  ];
  return $schema;
}

/**
 * Spalten aus 4.2 (TC-16, Unbeantwortete Fragen).
 *
 * @return array<string, array<string, mixed>>
 *   Feld-Definitionen für hook_schema() und hook_update_10001().
 */
function tannwald_assistant_log_fields_4_2(): array {
  return [
    'injection_verdacht' => [
      'description' => 'Number of context chunks matching an injection pattern (TC-16).',
      'type' => 'int',
      'size' => 'small',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ],
    'maschine_nid' => [
      'description' => 'Machine node the question was asked for, NULL without machine.',
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => FALSE,
    ],
    'frage_normalisiert' => [
      'description' => 'Question lowercased, whitespace collapsed, for grouping.',
      'type' => 'varchar',
      'length' => 255,
      'not null' => TRUE,
      'default' => '',
    ],
  ];
}

/**
 * Log: Spalten injection_verdacht, maschine_nid, frage_normalisiert.
 */
function tannwald_assistant_update_10001(): string {
  $schema = \Drupal::database()->schema();
  foreach (tannwald_assistant_log_fields_4_2() as $name => $spec) {
    if (!$schema->fieldExists('tannwald_assistant_log', $name)) {
      $schema->addField('tannwald_assistant_log', $name, $spec);
    }
  }
  foreach (['session_hash' => ['session_hash'], 'frage_normalisiert' => ['frage_normalisiert']] as $index => $fields) {
    if (!$schema->indexExists('tannwald_assistant_log', $index)) {
      $schema->addIndex('tannwald_assistant_log', $index, $fields, tannwald_assistant_schema()['tannwald_assistant_log']);
    }
  }
  return 'tannwald_assistant_log: injection_verdacht, maschine_nid, frage_normalisiert added.';
}

/**
 * Entity support_anfrage installieren.
 */
function tannwald_assistant_update_10002(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('support_anfrage') === NULL) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('support_anfrage'));
  }
  return 'Entity type support_anfrage installed.';
}
