msgid "Tannwald document manifest, one row per version"
msgstr "Tannwald-Dokumentmanifest, eine Zeile je Version"

msgid "Terms: @created created, @existing existing."
msgstr "Terme: @created angelegt, @existing vorhanden."

msgid "Export rules: set (direct config write, no audit entry exportregel_geaendert)."
msgstr "Exportregeln: gesetzt (direkt in die Konfiguration, kein Audit-Eintrag exportregel_geaendert)."

msgid "Export rules: unchanged."
msgstr "Exportregeln: unverändert."

msgid "Node access rebuilt in @seconds s."
msgstr "Zugriffsrechte in @seconds s neu berechnet."

msgid "Read confirmation: created (kunde-a, SRV-2026-19, TB200-2021-0417, 03.10.2026; no audit entry)."
msgstr "Lesebestätigung: angelegt (kunde-a, SRV-2026-19, TB200-2021-0417, 03.10.2026; kein Audit-Eintrag)."

msgid "Read confirmation: unchanged."
msgstr "Lesebestätigung: unverändert."

msgid "Read confirmation: skipped (tannwald_bulletin missing)."
msgstr "Lesebestätigung: übersprungen (tannwald_bulletin fehlt)."

msgid "Read confirmation: skipped (bulletin, machine or account missing)."
msgstr "Lesebestätigung: übersprungen (Bulletin, Maschine oder Konto fehlt)."

msgid "Queues: skipped (--skip-queues)."
msgstr "Queues: übersprungen (--skip-queues)."

msgid "@queue: @failed jobs failed (Ollama reachable?); the seed counts anyway, run drush tannwald:reindex and tannwald:queue-run later."
msgstr "@queue: @failed Jobs gescheitert (Ollama erreichbar?); der Seed gilt trotzdem, später drush tannwald:reindex und tannwald:queue-run ausführen."

msgid "tannwald_notify: @count jobs deleted (the demo mails come from the live approval of SB-2026-07)."
msgstr "tannwald_notify: @count Jobs gelöscht (die Demo-Mails entstehen bei der Live-Freigabe von SB-2026-07)."

msgid "Changes: @changes. Done in @seconds s."
msgstr "Änderungen: @changes. Fertig in @seconds s."

msgid "@failed migration rows failed; see the messages above."
msgstr "@failed Migrationszeilen gescheitert; siehe Meldungen oben."

msgid "Demo data only in DDEV (IS_DDEV_PROJECT), CI (CI) or on the demo server (TANNWALD_DEMO=1); nothing changed."
msgstr "Demo-Daten nur in DDEV (IS_DDEV_PROJECT), CI (CI) oder auf dem Demo-Server (TANNWALD_DEMO=1); nichts geändert."

