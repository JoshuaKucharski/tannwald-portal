<?php

/**
 * @file
 * Schema und Installation von tannwald_access.
 */

declare(strict_types=1);

use Drupal\node\NodeAccessRebuild;

/**
 * Implements hook_schema().
 */
function tannwald_access_schema(): array {
  // Spalten nach Pflichtenheft §5.4. Die Tabelle ist revisionssicher gedacht:
  // der Code schreibt nur (Insert), er ändert und löscht nie.
  $schema['tannwald_audit'] = [
    'description' => 'Audit log of myTannwald (insert only).',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Acting user; 0 for anonymous.',
      ],
      'ereignis' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Event: download, zugriff_verweigert, freigabe, exportregel_geaendert, lesebestaetigung.',
      ],
      'entity_type' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
      ],
      'entity_id' => [
        'type' => 'varchar_ascii',
        'length' => 128,
        'not null' => FALSE,
        'description' => 'Entity ID or configuration name.',
      ],
      'details' => [
        'type' => 'text',
        'size' => 'normal',
        'not null' => FALSE,
        'description' => 'JSON object.',
      ],
      'ip_land' => [
        'type' => 'varchar_ascii',
        'length' => 2,
        'not null' => FALSE,
        'description' => 'ISO 3166-1 alpha-2; PoC: field_land of the user, no GeoIP.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'ereignis' => ['ereignis'],
      'created' => ['created'],
      'entity' => ['entity_type', 'entity_id'],
    ],
  ];
  return $schema;
}

/**
 * Implements hook_install().
 */
function tannwald_access_install(bool $is_syncing): void {
  // node_install() schreibt die Standardzeile nid 0 / Realm "all" mit
  // grant_view 1. Bliebe sie stehen, könnte jedes Konto mit "access content"
  // jeden veröffentlichten Node sehen, bis jemand neu aufbaut. Darum sofort
  // und ohne Batch neu aufbauen: auf einer frischen Installation gibt es noch
  // keine Nodes, im PoC wenige. Der Seeder (2.3) baut nach dem Import erneut
  // auf.
  \Drupal::service(NodeAccessRebuild::class)->rebuild();
}

/**
 * Implements hook_uninstall().
 */
function tannwald_access_uninstall(): void {
  \Drupal::service(NodeAccessRebuild::class)->setNeedsRebuild();
}
