# myTannwald — Vorlage für /etc/mytannwald/env auf dem Server (deploy/, 4.1, ADR-012). NUR BEISPIELWERTE.
#
# bootstrap.sh legt /etc/mytannwald/env aus dieser Datei an (Modus 640, root:tannwald), wenn sie fehlt, und bricht
# dann ab: erst die Werte setzen, dann bootstrap.sh erneut. Jede Zeile mit CHANGE_ME muss ersetzt werden — die
# Skripte nennen sonst die Namen (nie Werte). Zufallswerte: openssl rand -hex 24.
# Form: NAME=wert oder NAME='wert' (einfache Anführungszeichen für $ und \). Kein Leerzeichen um =, kein ".
# Die Datei liest bootstrap.sh (Pool, MySQL, .htpasswd), deploy.sh (drush) und tannwald-cron.service (systemd).

# Demo-Domain (D4). A-Record auf 91.98.229.15; mail.<DOMAIN> für Mailpit ebenso (4.3).
DOMAIN=mytannwald.getleaven.com

# Zertifikat über certbot (certonly --nginx, bootstrap.sh --tls): zuerst on = Let's-Encrypt-Staging (Test-Zertifikat,
# Browser warnt, kein Rate-Limit); nach grünem Lauf off setzen und bootstrap.sh --tls erneut (echtes Zertifikat).
CERT_STAGING=on

# MySQL 8.0 der Maschine (bootstrap.sh legt Datenbank und Nutzer über den root-Socket an, nur wenn sie fehlen).
# Name und Nutzer nur aus Buchstaben, Ziffern, _; Passwort ohne Anführungszeichen, \, $ und Leerzeichen.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mytannwald
DB_USER=mytannwald
DB_PASSWORD=CHANGE_ME

# Drupal $settings['hash_salt'] — einmal erzeugen, nie ändern (sonst sind Sitzungen und Einmal-Links ungültig).
DRUPAL_HASH_SALT=CHANGE_ME

# Drupal $settings['trusted_host_patterns'] — regulärer Ausdruck für DOMAIN, mehrere durch Komma getrennt.
TRUSTED_HOST_PATTERN='^mytannwald\.getleaven\.com$'

# DashScope (Qwen über API, Chat; ADR-011, D11). Gleiche Namen wie in .ddev/.env; Werte setzt der Betreiber.
# Leer = Chat über DashScope nicht nutzbar (der Assistent zeigt den Limit-Hinweis); Install und Seeder laufen trotzdem.
# Form des Endpoints: https://<workspace>.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY_EU=
DASHSCOPE_ENDPOINT_EU=

# Embeddings über Ollama auf der Maschine (nur bge-m3, CPU; D11 Variante 2).
OLLAMA_HOST=http://127.0.0.1:11434

# Basic-Auth für Mailpit (mail.<DOMAIN>) und — mit SITE_AUTH=on — vor der ganzen Site (D9, 4.5).
# Hash erzeugen (fragt das Passwort ab, zeigt es nicht):  openssl passwd -6
# Der Hash beginnt mit $6$ — darum in einfachen Anführungszeichen.
BASIC_AUTH_USER=tannwald
BASIC_AUTH_HASH='CHANGE_ME'

# on = Besucher brauchen das Basic-Auth-Passwort vor der Site (D9 Variante a); off = Site offen.
SITE_AUTH=off

# Passwort des Drupal-Kontos admin. deploy.sh setzt es beim ersten Lauf (nach site:install, über die Umgebung —
# nie auf einer Befehlszeile, nie in einer Ausgabe). Danach in Drupal ändern; ein zweiter Lauf setzt es nicht neu.
ADMIN_PASSWORD=CHANGE_ME
